# Backend Environment Variables
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS — list allowed origins (NO wildcard * in production!)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ML Models
YOLO_MODEL_PATH=models/food_seg_best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Model auto-download (optional — downloads model on first startup if not present)
# Supports direct URLs and Google Drive share links
MODEL_DOWNLOAD_URL=
MODEL_FALLBACK_DOWNLOAD_URL=

# Firebase
FIREBASE_CREDENTIALS_PATH=config/firebase_service_account.json
FIREBASE_PROJECT_ID="food-calorie-estimation-2e3bd"

# Redis (optional)
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# Gemini API (optional — enhances low-confidence predictions)
GEMINI_API_KEY=
