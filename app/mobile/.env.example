# ─── Firebase Configuration ───
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxx

# ─── Backend API ───
# Local development: Use your PC's LAN IP (find with ipconfig)
# Production: https://nutrino-backend.onrender.com
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000

# ─── Sentry ───
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/xxxxx

# ─── Environment ───
EXPO_PUBLIC_APP_ENV=development
