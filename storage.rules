rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Community Images ────────────────────────────────────────────────
    // Users can upload images under their own UID folder.
    // All authenticated users can read community images.
    // Max file size: 5 MB, images only.
    match /community/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── User Avatars ────────────────────────────────────────────────────
    // Users can upload their own avatar image.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Default deny ────────────────────────────────────────────────────
    // Everything else is denied by default (no match = deny).
  }
}
